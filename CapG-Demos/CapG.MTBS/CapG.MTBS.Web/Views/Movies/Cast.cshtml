@model CapG.MTBS.Web.Models.MovieCastViewModel

@{
    ViewData["Title"] = "Cast";
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Cast">
            <div class="form-group">
                <label class="control-label">Select Movie</label>
                <select name="movieId" asp-items="@ViewBag.Movies" class="form-control" required>
                    <option value = "">Please Select</option>
                </select>
                <span class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Get Details" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@if(Model != null)
{
    <div>
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Genre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Genre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DirectorName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DirectorName)
        </dd>
    </dl>
    </div>

    <h4>Cast</h4>

    <table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Actors.FirstOrDefault().Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Actors.FirstOrDefault().Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Actors.FirstOrDefault().Gender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Actors.FirstOrDefault().DateOfBirth)
            </th>
            @if (User.IsInRole("Admin"))
            {
                <th>
                    Actions
                </th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Actors) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gender)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateOfBirth)
            </td>          
            @if (User.IsInRole("Admin"))
            {
                <td>
                @Html.ActionLink("Edit", "Edit", "Actors", new { id=item.Id }) |
                @Html.ActionLink("Details", "Details", "Actors", new { id = item.Id }) |
                @Html.ActionLink("Delete", "Delete", "Actors", new { id = item.Id })
                </td>
            }                  
        </tr>
    }
    </tbody>
</table>
}


