@model IEnumerable<CapG.MTBS.Models.Dtos.MovieDto>
@using CapG.MTBS.Models.Dtos

@{
    ViewData["Title"] = "Index";
}

<h1>Movie List</h1>

@if(TempData["Message"] != null)
{
    <partial name="_alert" />
}

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Director.Name)
            </th>
            @if (User.IsInRole("Admin"))
                {
                    <th>
                        Actions
                    </th>
                }
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Where(m => m.IsDeleted == false)) {
        if (item.IsDeleted == false)
        {
            <tr>
                <td>
                @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Director.Name)
                </td>
                @if (User.IsInRole("Admin"))
                    {
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                            @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                            @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                        </td>
                    }
            </tr>
        }
}
    </tbody>
</table>
